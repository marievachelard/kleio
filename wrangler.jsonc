{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["30 6 * * *", "30 7 * * *"]
  },
  "kv_namespaces": [
    { "binding": "KLEIO_KV", "id": "32f996652c48404d851404469cfa2fa5" }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "BCX7hdqXqnFDbBGs2DP1Sh84xZN3cic_qW-85RMJ_ox6WrmKMnLXEbln0Ydr87gdpMUQF8B2em0Y8GHe4K2jsKw",
    "VAPID_SUBJECT": "https://github.com/marievachelard/kleio"
  }
}
