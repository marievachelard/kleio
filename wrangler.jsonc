{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["30 6 * * *", "30 7 * * *"]
  },
  "kv_namespaces": [
    { "binding": "KLEIO_KV", "id": "REMPLACER_APRES_CREATION_KV" }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "REMPLACER_APRES_GENERATION",
    "VAPID_SUBJECT": "https://github.com/marievachelard/kleio"
  }
}
